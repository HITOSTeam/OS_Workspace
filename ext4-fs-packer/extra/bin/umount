#!/bin/sh

all_plain=1
for arg in "$@"; do
    if [ "${arg#-}" != "$arg" ]; then
        all_plain=0
        break
    fi
done

if [ $# -gt 0 ] && [ "$all_plain" -eq 1 ]; then
    status=0
    for arg in "$@"; do
        resolved="$(realpath "$arg" 2>/dev/null || printf '%s\n' "$arg")"
        if ! awk -v target="$resolved" '$2 == target { found = 1; exit } END { exit !found }' /proc/mounts; then
            exec /bin/busybox umount "$@"
        fi
        /user/umount_once.bin "$resolved"
        rc=$?
        [ $rc -eq 0 ] || status=$rc
    done
    exit "$status"
fi

exec /bin/busybox umount "$@"
